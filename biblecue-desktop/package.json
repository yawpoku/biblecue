{
  "name": "biblecue",
  "version": "1.3.0",
  "description": "Real-time Bible verse display for church services",
  "author": "BibleCue Contributors",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac --x64 --arm64",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.biblecue.app",
    "productName": "BibleCue",
    "compression": "store",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity"
    },
    "extraResources": [
      {
        "from": "python/backend.exe",
        "to": "python/backend.exe",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "python/backend",
        "to": "python/backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "BibleCue",
      "menuCategory": "Church Tools",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerHeaderIcon": "assets/icon.ico",
      "include": "build/installer.nsh"
    },
    "dmg": {
      "title": "BibleCue ${version}"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3"
  }
}
