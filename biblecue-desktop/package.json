{
  "name": "biblecue",
  "version": "1.1.1",
  "description": "Real-time Bible verse display for church services",
  "author": "BibleCue Contributors",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.biblecue.app",
    "productName": "BibleCue",
    "win": {
      "target": "nsis",
      "icon": "assets/bLogo.png"
    },
    "extraResources": [
      { "from": "python/backend.exe", "to": "python/backend.exe" }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "BibleCue",
      "menuCategory": "Church Tools",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerHeaderIcon": "assets/bLogo.png"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
