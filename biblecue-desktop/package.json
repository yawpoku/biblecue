{
  "name": "biblecue",
  "version": "1.1.1",
  "description": "Real-time Bible verse display for church services",
  "author": "BibleCue Contributors",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac --x64 --arm64",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.biblecue.app",
    "productName": "BibleCue",
    "win": {
      "target": "nsis",
      "icon": "assets/bLogo.png"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "icon": "assets/bLogo.png",
      "category": "public.app-category.productivity"
    },
    "extraResources": [
      {
        "from": "python/backend.exe",
        "to": "python/backend.exe",
        "filter": ["**/*"]
      },
      {
        "from": "python/backend",
        "to": "python/backend",
        "filter": ["**/*"]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "BibleCue",
      "menuCategory": "Church Tools",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerHeaderIcon": "assets/bLogo.png"
    },
    "dmg": {
      "title": "BibleCue ${version}",
      "background": "assets/bLogo.png",
      "window": { "width": 540, "height": 380 }
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
